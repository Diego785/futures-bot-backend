# Plantilla del despliegue paper-test (gate #7). Copia a .env.paper y rellena.
# Regla Cero: shadow read-only sobre mercado PÚBLICO → NO requiere credenciales del exchange.
NODE_ENV=production
PORT=3301
EXCHANGE_PROVIDER=binance

# Base de datos PROPIA del v2 (contenedor aislado; DB_HOST lo sobreescribe el compose a 'postgres').
DB_ENABLED=true
DB_HOST=postgres
DB_PORT=5432
DB_USER=futures_bot_v2
DB_PASS=CAMBIA_ESTO_password_nuevo_del_v2
DB_NAME=futures_bot_v2

# Ingest en vivo de los 10 símbolos (15m para el gatillo + 4h para el sesgo).
MARKET_DATA_LIVE=true
MARKET_DATA_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT,SOLUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,DOTUSDT
MARKET_DATA_TIMEFRAMES=15m,4h

# Paper-test: registra lo que el candidato CONGELADO haría. NO coloca órdenes.
PAPER_TRADING=true
# Reloj del gate: se DEJA VACÍO hasta encender. Mientras esté vacío, todo es histórico (no se
# persiste nada). Para arrancar el reloj limpio: poner la fecha ISO del momento y reiniciar el app.
PAPER_CLOCK_START=
