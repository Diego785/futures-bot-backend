# Plantilla del v2 paper-test (gate #7). Copia a .env y rellena DB_PASS.
# Regla Cero: shadow read-only sobre mercado PÚBLICO → NO requiere credenciales del exchange.
NODE_ENV=production
PORT=3300
EXCHANGE_PROVIDER=binance

# Base de datos: reusa el postgres-db existente, en una database PROPIA del v2 (créala antes:
# CREATE DATABASE futures_bot_v2;). DB_PASS = el mismo password del postgres-db (el del v1).
DB_ENABLED=true
DB_HOST=38.242.145.246
DB_PORT=5432
DB_USER=postgres
DB_PASS=EL_PASSWORD_DEL_POSTGRES_DB
DB_NAME=futures_bot_v2

# Ingest en vivo de los 10 símbolos (15m para el gatillo + 4h para el sesgo).
MARKET_DATA_LIVE=true
MARKET_DATA_SYMBOLS=BTCUSDT,ETHUSDT,XRPUSDT,SOLUSDT,BNBUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,DOTUSDT
MARKET_DATA_TIMEFRAMES=15m,4h

# Paper-test: registra lo que el candidato CONGELADO haría. NO coloca órdenes.
PAPER_TRADING=true
# Reloj del gate: VACÍO hasta encender. Mientras esté vacío NO se persiste nada (todo es contexto).
# Para arrancar el reloj limpio: poner la fecha ISO del momento y reiniciar el contenedor.
PAPER_CLOCK_START=
